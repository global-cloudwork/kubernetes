---
# Repository Write Secret for Source Hydrator
#
# IMPORTANT: This is a TEMPLATE file. Do NOT commit the actual secret to git.
#
# To create the actual secret:
# 1. Generate a GitHub Personal Access Token with 'repo' scope
# 2. Replace GITHUB_USERNAME and GITHUB_PAT_TOKEN with actual values
# 3. Apply the secret to the cluster:
#    kubectl create -f kubernetes/core/hydrator-secret.yaml (after filling in values)
# 4. DO NOT commit the secret file to git

apiVersion: v1
kind: Secret
metadata:
  name: global-cloudwork-kubernetes-write
  namespace: argocd
  labels:
    argocd.argoproj.io/secret-type: repository-write
type: Opaque
stringData:
  type: git
  url: https://github.com/global-cloudwork/kubernetes
  username: GITHUB_USERNAME_HERE
  password: GITHUB_PAT_TOKEN_HERE
